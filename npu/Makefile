# NPU - Verilator-only flow (Icarus was removed from the flow).
# The single source list is files.f (shared with the LSP).

HAVE_VERILATOR := $(shell command -v verilator 2> /dev/null)

ifeq ($(HAVE_VERILATOR),)
  RUN = nix develop ..\#hardware -c
else
  RUN =
endif

BUILD_DIR = build
FILELIST  = files.f
# Sources derived from files.f (single source of truth; do not duplicate the list here).
SRCS := $(shell sed -e '/^#/d' -e '/^[[:space:]]*$$/d' $(FILELIST))

# Testbenches: one per tier - convention tb_<tier>.sv = make test-<tier>.
TB        = tests/tb.sv         # legacy smoke (prints; no assertions)
TB_CORE   = tests/tb_core.sv    # tier 1: self-checking, hand-computed constants
TB_PARITY = tests/tb_parity.sv  # tier 2: golden vectors from the Rust bit-exact model

CORE_DIR   = $(BUILD_DIR)/core
PARITY_DIR = $(BUILD_DIR)/parity

# Common flags for all testbenches.
VFLAGS = --binary --timing --assert --trace \
	--quiet --quiet-build --quiet-stats \
	-Wno-fatal -Wno-TIMESCALEMOD

.PHONY: all sim run test test-core test-parity wave wave-core wave-parity lint clean

all: test

$(BUILD_DIR) $(CORE_DIR) $(PARITY_DIR):
	@mkdir -p $@

# 1. Legacy smoke - kept for manual debug and wave viewing.
$(BUILD_DIR)/npu_sim: $(FILELIST) $(SRCS) $(TB) | $(BUILD_DIR)
	@$(RUN) verilator $(VFLAGS) \
		-f $(FILELIST) $(TB) --top-module tb \
		-o npu_sim -Mdir $(BUILD_DIR)

sim: $(BUILD_DIR)/npu_sim
	@$(RUN) ./$(BUILD_DIR)/npu_sim +verilator+quiet

run: sim

# 2. Tier 1 (tb_core) - gate for every commit: assertions + $fatal.
#    The exit code propagates through make (this is what ties `make test`
#    to the self-checking testbench).
$(CORE_DIR)/tb_core_sim: $(FILELIST) $(SRCS) $(TB_CORE) | $(CORE_DIR)
	@$(RUN) verilator $(VFLAGS) \
		-f $(FILELIST) $(TB_CORE) --top-module tb_core \
		-o tb_core_sim -Mdir $(CORE_DIR)

test-core: $(CORE_DIR)/tb_core_sim
	@$(RUN) ./$(CORE_DIR)/tb_core_sim +verilator+quiet

# 3. Tier 2 (tb_parity) - RTL vs the Rust bit-exact model, bit for bit.
#    Golden vectors are read from data/golden/ at runtime (generated by the
#    Rust exporter; never committed). Requires tests/tb_parity.sv to land.
$(PARITY_DIR)/tb_parity_sim: $(FILELIST) $(SRCS) $(TB_PARITY) | $(PARITY_DIR)
	@$(RUN) verilator $(VFLAGS) \
		-f $(FILELIST) $(TB_PARITY) --top-module tb_parity \
		-o tb_parity_sim -Mdir $(PARITY_DIR)

test-parity: $(PARITY_DIR)/tb_parity_sim
	@$(RUN) ./$(PARITY_DIR)/tb_parity_sim +verilator+quiet

test: test-core #test-parity 

wave: sim
	@$(RUN) gtkwave $(BUILD_DIR)/dump.vcd

wave-core: test-core
	@$(RUN) gtkwave $(CORE_DIR)/dump.vcd

wave-parity: test-parity
	@$(RUN) gtkwave $(PARITY_DIR)/dump.vcd

# RTL quality gate: -Wall with no WIDTH* suppressions; must come out clean.
# Lint top = npu (covers wrapper + engines + all primitives).
lint:
	@$(RUN) verilator --lint-only -Wall --top-module npu -f $(FILELIST)

clean:
	@rm -rf $(BUILD_DIR)
